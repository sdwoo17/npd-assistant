# Server environment only. manage.py does not automatically load this file.
NPD_MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=
AWS_REGION=ap-northeast-2
# Use json_schema only for a model supporting Bedrock structured output.
# Use tool for compatible models supporting forced tool use.
# Use strict_tool only when the chosen model also supports strict tool schemas.
BEDROCK_OUTPUT_MODE=json_schema
# AWS credentials follow boto3's normal credential chain; prefer an execution role.
# Optional local Bedrock-only API key. Do not commit a value or enter it in the browser.
AWS_BEARER_TOKEN_BEDROCK=
# Optional alternative provider: set NPD_MODEL_PROVIDER=openai explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=
APP_STORE_CONNECT_TOKEN=
NPD_DATA_DIR=runtime
